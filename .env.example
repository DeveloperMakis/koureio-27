# ==========================================================================
# ΤΟ ΚΟΥΡΕΙΟΝ 27 — Παράδειγμα μεταβλητών περιβάλλοντος
# Αντιγράψτε σε .env.local και συμπληρώστε. ΜΗΝ ανεβάσετε το .env σε git.
# ==========================================================================

# --- Βάση δεδομένων ---------------------------------------------------------
# Τοπική ανάπτυξη (SQLite, προεπιλογή — δεν χρειάζεται server):
DATABASE_URL="file:./dev.db"
# Παραγωγή (PostgreSQL) — αλλάξτε και το provider στο prisma/schema.prisma σε "postgresql":
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/koureion27?schema=public"

# --- Admin session (iron-session) ------------------------------------------
# Τυχαίο μυστικό 32+ χαρακτήρων. Δημιουργία: `openssl rand -base64 32`
SESSION_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"

# --- Public URL (για canonical, sitemap, ICS, cancel links) ----------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Email provider (ΠΡΟΑΙΡΕΤΙΚΟ) ------------------------------------------
# Οι επιβεβαιώσεις/υπενθυμίσεις στέλνονται ΜΟΝΟ όταν συμπληρωθεί πραγματικός πάροχος.
# Χωρίς αυτά, το σύστημα ΔΕΝ προσποιείται ότι έστειλε email.
# EMAIL_PROVIDER="resend"            # π.χ. resend | smtp
# EMAIL_FROM="ΤΟ ΚΟΥΡΕΙΟΝ 27 <no-reply@example.gr>"
# RESEND_API_KEY=""
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""

# --- SMS provider (ΠΡΟΑΙΡΕΤΙΚΟ) --------------------------------------------
# SMS_PROVIDER=""                    # π.χ. twilio | yuboto
# SMS_FROM=""
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""

# --- Mobile app / Customer auth ---------------------------------------------
# Μυστικό υπογραφής access tokens κινητού (32+ χαρ). Αν λείπει, γίνεται fallback
# στο SESSION_SECRET. Για παραγωγή ορίστε ξεχωριστό:
# MOBILE_JWT_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"

# --- Push notifications (Expo) — ΠΡΟΑΙΡΕΤΙΚΟ, για τον worker ----------------
# Expo access token για αποστολή push (από expo.dev). Χωρίς αυτό ΔΕΝ στέλνεται
# push· το inbox της εφαρμογής λειτουργεί κανονικά.
# EXPO_ACCESS_TOKEN=""

# --- Background worker (ειδοποιήσεις/υπενθυμίσεις) --------------------------
# Μυστικό για το /api/worker/run (cron ή `npm run worker`). ΥΠΟΧΡΕΩΤΙΚΟ για push.
# WORKER_SECRET="REPLACE_WITH_RANDOM_SECRET"
# WORKER_INTERVAL_MS="60000"   # κάθε πόσο τρέχει το τοπικό poller (ms)
